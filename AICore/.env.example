# Bu faylı ".env" adı ilə kopyalayın və dəyərləri doldurun.
# .env faylını heç vaxt GitHub-a yükləməyin.

# ---------------------------------------------------------------
# Provayder: gemini (PULSUZ, standart) və ya claude (pullu)
# ---------------------------------------------------------------
PROVIDER=gemini

# PULSUZ açar: https://aistudio.google.com/apikey  (Google hesabı ilə, kart tələb olunmur)
GEMINI_API_KEY=AQ.Ab8RN6Jz7SzOrH9SZ0WQ438l0x1jtl8DYi1uooN4KtDgIikuVA

# Model adı. Pulsuz səviyyədə Flash modelləri istifadə olunur.
# Əsas model tapılmasa, ehtiyat modellər avtomatik yoxlanılır.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest

# --- Yalnız PROVIDER=claude olanda (pullu) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------
# Ümumi (istəyə bağlı)
# ---------------------------------------------------------------
MAX_OUTPUT_TOKENS=4096
SECRET_KEY=uzun-tesadufi-bir-metn-yazin
RATE_LIMIT_PER_MINUTE=10
PORT=5000
FLASK_DEBUG=0
